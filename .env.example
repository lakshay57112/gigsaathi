# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key from https://aistudio.google.com/apikey
# Without it the app still runs, but the AI features show a clear "not set up" message.
GEMINI_API_KEY=

# Model name. Google retires older models, so check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# The product name shown in the app.
APP_NAME=GigSaathi

# Where the SQLite database file lives. On Cloud Run use a mounted volume or accept that data
# resets when the container restarts (see README, Deployment).
# DATABASE_PATH=/data/gigsaathi.db

# Time zone used to decide what "today" means for the dashboard.
APP_TIMEZONE=Asia/Kolkata

# AI calls allowed per device per minute, and across the whole server per minute.
AI_RATE_LIMIT_PER_MINUTE=10
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Only needed when running the frontend dev server on another port (comma-separated).
# CORS_ORIGINS=http://localhost:5173

# Set to false if the app is exposed without a proxy in front of it.
# TRUST_FORWARDED_FOR=true
